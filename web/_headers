/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# The shell must never be cached, or a deploy cannot reach returning visitors.
/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache

# Everything below is content-addressed by the build or changes only with it,
# so a year is safe and makes repeat visits nearly free.
/main.dart.js
  Cache-Control: public, max-age=31536000, immutable
/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=604800
/og-image.jpg
  Cache-Control: public, max-age=604800
/favicon.png
  Cache-Control: public, max-age=604800
